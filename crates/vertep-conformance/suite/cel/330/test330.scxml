<?xml version="1.0" encoding="UTF-8"?><!-- check that the required fields are present in both internal and external events --><scxml xmlns:conf="http://www.w3.org/2005/scxml-conformance" xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="s0" datamodel="cel" name="machineName">
     
 <state id="s0">
   <onentry>
     <raise event="foo"/>
   </onentry>
   <transition event="foo" cond="has(_event.name) &amp;&amp; has(_event.type) &amp;&amp; has(_event.sendid) &amp;&amp; has(_event.origin) &amp;&amp; has(_event.origintype) &amp;&amp; has(_event.invokeid) &amp;&amp; has(_event.data)" target="s1"/> 
      <transition event="*" target="fail"/> 
   </state>
   
 <state id="s1">
   <onentry>
     <send event="foo"/>
   </onentry>
   <transition event="foo" cond="has(_event.name) &amp;&amp; has(_event.type) &amp;&amp; has(_event.sendid) &amp;&amp; has(_event.origin) &amp;&amp; has(_event.origintype) &amp;&amp; has(_event.invokeid) &amp;&amp; has(_event.data)" target="pass"/> 
      <transition event="*" target="fail"/> 
   </state>
   
    
   <final id="pass"><onentry><log label="Outcome" expr="'pass'"/></onentry></final>
   <final id="fail"><onentry><log label="Outcome" expr="'fail'"/></onentry></final>
     
</scxml>