# The pinned toolchain of the reproducible build (M13 production-readiness, "Reproducible
# Toolchain"). One file, sourced by scripts/*.sh and copied into the build image
# (.devcontainer/Dockerfile). scripts/check-toolchain.sh fails when any other place that names one
# of these versions disagrees with it:
#
#   RUST_VERSION          rust-toolchain.toml `channel`, the FROM line of .devcontainer/Dockerfile
#   WASM_BINDGEN_VERSION  the `=` pin of wasm-bindgen in crates/vertep-wasm/Cargo.toml, the
#                         wasm-bindgen entry of Cargo.lock, and the wasm-bindgen CLI that runs
#
# To move a pin: change it here, run scripts/check-toolchain.sh, fix what it names, and update the
# checksums below from the upstream SHASUMS files.
#
# @tg: implements:: [[decisions#The toolchain is a script and a container]]

RUST_VERSION=1.95.0

# The CLI must equal the library exactly: the CLI reads the custom sections the library's macros
# emit, and their schema changes between versions.
WASM_BINDGEN_VERSION=0.2.128
WASM_BINDGEN_SHA256_X86_64=b51f0208fdff83515a787bd8ab9ac5865ed84dabb66d0c709957bb59793c645f
WASM_BINDGEN_SHA256_AARCH64=079731dd1bc7798c1efa4f08fcc45130827cbcc9ff60a0b4c6047d64fc6fd25c

# Node.js for the TypeScript build, npm pack and the package smoke test. The packages need >= 22.
NODE_VERSION=24.22.3
NODE_SHA256_X64=4f2b175a6d53a5c617a80dba2676238a0688cef28c6da4eba35c7d844e66fcfb
NODE_SHA256_ARM64=6e51a2ada00f0011cc266f65d98922b403d7ad88f809ca2aa615a5fe1ce6e86c
NODE_MIN_MAJOR=22

# clang and llvm-ar for wasm32: sqlite-wasm-rs (the journal build) compiles SQLite's C sources.
# Debian trixie ships LLVM 19; on macOS any Homebrew LLVM with a wasm32 backend works.
LLVM_MAJOR=19

# maturin builds the Python wheel (pyproject.toml accepts >=1.9.4,<2).
MATURIN_VERSION=1.16.0
