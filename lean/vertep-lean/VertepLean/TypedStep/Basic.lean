import VertepLean.Theorems
import VertepLean.Types.Check

/-!
# Chart type soundness: the statement's vocabulary

The Lean `step` has no expression typer: every value it writes to a location comes from the
datamodel's answer tape (`evalValue`, `evalContent`, `foreachItems`), from the invoker's data at
start, or is generated by the core (`idlocation` strings, `undefined` for a bare `<assign>`,
`foreach` indices). Type soundness is therefore stated relative to

* a **chart typing** `ChartTyping`: the declaration block, the declared type of each location,
  the declared payload of each event, and the static type the Rust chart checker
  (`crates/vertep-core/src/types/chart.rs`, `check_chart`, with the datamodel's typer) gives each
  expression, each inline content and the items of each `foreach` array; `none` is `value`
  (untyped location, undeclared event) or `ExprType::Unknown` (no static type);
* `ChartOk`: the checks the Rust checker makes, stated as the properties they establish over this
  typing (every check is listed with its Rust counterpart);
* `TapeTyped`: the datamodel's obligation, which the typed CEL and `rust` datamodels discharge:
  an answer to a request for an expression, a content or a `foreach` array whose static type is
  `T` is a value of type `T`.

Expression types are given per expression text, not per occurrence: `Γ.expr x` must be a type
of `x` wherever the chart evaluates it (the Rust checker types each occurrence in the event scope
of its transition; an expression read under several scopes with different payload types needs a
type valid in all of them, such as `value`, in `Γ`).
-/

namespace Vertep.Typed

open Types

/-- The static typing of a chart, as the Rust chart checker computes it. -/
-- @tg: implements:: [[openspec:formal-model#Type Soundness Statement]]
structure ChartTyping where
  /-- The declaration block (`vt:types`). -/
  decls : Decls
  /-- The declared type of a location: a `<data>` item's `vt:type` or the type the typer gives
  a location expression (`ctx.total`); `none` for `value`. -/
  loc : String → Option Ty
  /-- The declared payload of an event name (Rust `ChartTypes::events`): `none` undeclared,
  `some none` declared without payload, `some (some t)` declared with payload `t`. -/
  event : String → Option (Option Ty)
  /-- The static type of a value expression (`ExprType::Known`); `none` for `Unknown`. -/
  expr : Expr → Option Ty
  /-- The static type of the value of an inline content (`<data>`, `<assign>`, `<content>`). -/
  content : String → Option Ty
  /-- The static type of the items a `foreach` over this array expression iterates. -/
  items : Expr → Option Ty

variable (Γ : ChartTyping)

/-- `U` is assignable to `T`: every value of type `U` has type `T` (what Rust `is_assignable`
approximates). -/
def Sub (U T : Ty) : Prop := ∀ v, HasType Γ.decls v U → HasType Γ.decls v T

/-- A value is typed by an optional static type (`none`: no constraint). -/
def ValTyped (o : Option Ty) (v : Value) : Prop := ∀ T, o = some T → HasType Γ.decls v T

/-- A value fits location `l`: `l` is untyped or the value has its declared type. -/
def LocTyped (l : String) (v : Value) : Prop := ValTyped Γ (Γ.loc l) v

/-- A payload fits event name `n` (Rust `ChartTypes::check_event`): anything for an undeclared
event, an absent payload for an event declared without payload, else a value of the declared
type. -/
def PayloadTyped (n : String) (v : Value) : Prop :=
  match Γ.event n with
  | none => True
  | some none => absent v = true
  | some (some T) => HasType Γ.decls v T

/-- An event whose declared payload type, if any, its data has. -/
def EventTyped (e : Event) : Prop := PayloadTyped Γ e.name e.data

/-- Effects carrying events (`send`, `forward`) carry typed events. -/
def EffectTyped : Effect → Prop
  | .send r => EventTyped Γ r.event
  | .forward _ e => EventTyped Γ e
  | _ => True

/-- The datamodel's obligation for one answer: the value of an expression, a content or the
items of a `foreach` array have the static type the checker gave it (and a `foreach` iterates
fewer than `2^63` items, so its indices are `int`s). -/
def AnswerTyped : Request → Answer → Prop
  | .evalValue x, .value v => ValTyped Γ (Γ.expr x) v
  | .evalContent c, .value v => ValTyped Γ (Γ.content c) v
  | .foreachItems x, .values vs => vs.length < 2 ^ 63 ∧ ∀ v ∈ vs, ValTyped Γ (Γ.items x) v
  | _, _ => True

/-- **`TapeTyped`**: every answer on the tape satisfies the datamodel's obligation. -/
-- @tg: implements:: [[openspec:formal-model#Type Soundness Statement]]
def TapeTyped (t : Tape) : Prop := ∀ e ∈ t, AnswerTyped Γ e.request e.answer

/-- A request that writes a typed location writes a value of its type (`assignValue`,
`bindVar`) or an expression whose static type is assignable to it (`assignExpr`, as Rust
`expect`, which leaves an `Unknown` expression to the datamodel's checked conversion), and the
events made current (`setEvent`) are typed. -/
def ReqTyped : Request → Prop
  | .assignValue l v => LocTyped Γ l v
  | .bindVar l v => LocTyped Γ l v
  | .assignExpr l x => ∀ T U, Γ.loc l = some T → Γ.expr x = some U → Sub Γ U T
  | .setEvent e => EventTyped Γ e
  | _ => True

/-! ## Payloads -/

/-- Where each entry of a payload object comes from: the `namelist` names (keyed by the whole
location, as Rust `eval_payload`), then the `<param>`s (`expr`, else `location`, else none). -/
def entrySrcs (names : List String) (ps : List Param) : List (String × Option Expr) :=
  names.map (fun n => (n, some n)) ++
    ps.map (fun p => (p.name, match p.expr, p.location with
      | some x, _ => some x
      | none, some l => some l
      | none, none => none))

/-- The entries of a payload object, typed by their sources. -/
def EntriesTyped : List (String × Option Expr) → List (String × Value) → Prop
  | [], [] => True
  | (k, src) :: ss, (k', v) :: es =>
    k' = k ∧ (match src with
      | some x => ValTyped Γ (Γ.expr x) v
      | none => v = .undefined) ∧ EntriesTyped ss es
  | _, _ => False

/-- The payloads `evalPayload names ps c` can compute from typed answers. -/
def PayloadRes (names : List String) (ps : List Param) (c : Option Content) (v : Value) : Prop :=
  match c with
  | some c =>
    match c.expr, c.body with
    | some x, _ => ValTyped Γ (Γ.expr x) v
    | none, some b => ValTyped Γ (Γ.content b) v
    | none, none => v = .undefined
  | none =>
    if names.isEmpty && ps.isEmpty then v = .undefined
    else ∃ es, v = .object es ∧ EntriesTyped Γ (entrySrcs names ps) es

/-- Every payload the element can compute from typed answers fits event `n` (Rust
`Checker::send`: content against the payload type, `<param>`s and `namelist` entries against the
record's fields, missing fields optional, no payload for an event declared without one). -/
def PayOk (n : String) (names : List String) (ps : List Param) (c : Option Content) : Prop :=
  ∀ v, PayloadRes Γ names ps c v → PayloadTyped Γ n v

/-- The data of a `done.state` event: `undefined` (no `<donedata>`, or its evaluation failed)
or a payload of the `<donedata>`. -/
def DoneRes (dd : Option DoneData) (v : Value) : Prop :=
  v = .undefined ∨ ∃ d, dd = some d ∧ PayloadRes Γ [] d.params d.content v

/-! ## The checks of the chart checker -/

/-- A location every string fits (Rust: `string` is assignable to its type), for the identifiers
the core stores at `idlocation`. -/
def StrLoc (l : String) : Prop := ∀ str, LocTyped Γ l (.str str)

/-- The checks of a `<send>`: for every event name it can carry (its `event`, any name for an
`eventexpr`, the empty name for neither) every payload it computes fits the name; `idlocation`
holds strings. -/
def SendOk (s : Send) : Prop :=
  (∀ n, (∀ m, s.event = some m → n = m) → (s.event = none → s.eventexpr = none → n = "") →
    PayOk Γ n s.namelist s.params s.content) ∧
  (∀ l, s.idlocation = some l → StrLoc Γ l)

mutual
/-- The checks of an executable content element. -/
def ExecOk : Exec → Prop
  | .mk k _ => KindOk k
/-- The checks of an executable content element, by kind. -/
def KindOk : ExecKind → Prop
  | .raise ev => PayloadTyped Γ ev .undefined
  | .send s => SendOk Γ s
  | .assign l x c =>
    match x, c with
    | some x, _ => ∀ T U, Γ.loc l = some T → Γ.expr x = some U → Sub Γ U T
    | none, some c => ∀ v, ValTyped Γ (Γ.content c) v → LocTyped Γ l v
    | none, none => LocTyped Γ l .undefined
  | .if_ bs => BranchesOk bs
  | .foreach x item idx body =>
    (∀ v, ValTyped Γ (Γ.items x) v → LocTyped Γ item v) ∧
    (∀ i, idx = some i → ∀ k, k < 2 ^ 63 → LocTyped Γ i (Value.ofNat k)) ∧ BlockOk body
  | .cancel _ _ => True
  | .log _ _ => True
  | .script _ => True
  | .extension _ => True
/-- The checks of a block. -/
def BlockOk : List Exec → Prop
  | [] => True
  | e :: es => ExecOk e ∧ BlockOk es
/-- The checks of the branches of an `if`. -/
def BranchesOk : List (Option Expr × List Exec) → Prop
  | [] => True
  | (_, b) :: bs => BlockOk b ∧ BranchesOk bs
end

/-- The checks of a `<data>` initializer (Rust `Checker::data_init`): its value fits the item. -/
def DataOk (d : Data) : Prop :=
  match d.expr, d.content with
  | some x, _ => ∀ v, ValTyped Γ (Γ.expr x) v → LocTyped Γ d.id v
  | none, some c => ∀ v, ValTyped Γ (Γ.content c) v → LocTyped Γ d.id v
  | none, none => True

/-- **`ChartOk`**: the chart passed the checker under typing `Γ`. Every field is a check of
`check_chart` (`crates/vertep-core/src/types/chart.rs`), stated as the property it establishes:

* `data`: `<data>` initializers (`Checker::data_init`);
* `onentry`, `onexit`, `trans`, `invokes`: executable content (`Checker::exec`): `<assign>`
  values (`expect`), a bare `<assign>` only to a location that accepts `undefined`, `<raise>`
  only of events whose payload may be absent, `<send>` payloads (`Checker::check_payload`),
  `idlocation`s of `<send>` and `<invoke>` hold strings (`Checker::idlocation`), `foreach` item
  and index locations accept the items and `int`s;
* `done`, `doneParallel`: a declared `done.state.<id>` accepts no data
  (`Checker::platform_events`) and the `<donedata>` of the final children of `<id>`
  (`check_payload`);
* `errors`: a declared `error.execution` or `error.communication` accepts the platform payload
  `{kind, message}` (`platform_events`);
* `nullContent`: the `null` datamodel's content values (the content as a string) are typed.

Where a value comes from an expression or inline content its typer cannot type (`Unknown`),
the Rust checker accepts it and leaves it to the datamodel's checked conversion (requirement
"Dynamic Value Boundary"); `ChartOk` instead asks for a static type wherever such a value
reaches a typed location or a declared payload. A `<send eventexpr>` carries an event name known
only at runtime: `ChartOk` asks its payload to fit every declared event. -/
-- @tg: implements:: [[openspec:formal-model#Type Soundness Statement]]
structure ChartOk (cc : CChart) : Prop where
  data : ∀ i, ∀ d ∈ (cc.st i).data, DataOk Γ d
  onentry : ∀ i, ∀ b ∈ (cc.st i).onentry, BlockOk Γ b
  onexit : ∀ i, ∀ b ∈ (cc.st i).onexit, BlockOk Γ b
  trans : ∀ t, BlockOk Γ (cc.tr t).body
  invokes : ∀ i, ∀ v ∈ (cc.st i).invokes,
    (∀ l, v.idlocation = some l → StrLoc Γ l) ∧ BlockOk Γ v.finalize
  done : ∀ s v, ¬((cc.st s).parent.getD 0 == 0) = true → DoneRes Γ (cc.st s).donedata v →
    PayloadTyped Γ s!"done.state.{(cc.st ((cc.st s).parent.getD 0)).id}" v
  doneParallel : ∀ g, PayloadTyped Γ s!"done.state.{(cc.st g).id}" .undefined
  errors : ∀ name msg sid, (name = "error.execution" ∨ name = "error.communication") →
    EventTyped Γ (Interp.platformError name msg sid)
  nullContent : cc.datamodel = "null" → ∀ c, ValTyped Γ (Γ.content c) (.str c)

/-! ## Typed sessions, inputs and datamodels -/

/-- A session whose queued internal events are typed. -/
def SessionTyped (s : Session) : Prop := ∀ e ∈ s.internal, EventTyped Γ e

/-- An input whose event is typed. The hosts check every non-platform event on admission
(`Datamodel::check_event` in `vertep-core`'s `datamodel` module) and deliver `error.execution`
instead of an event whose payload does not have its declared type (decision "Hosts instantiate
CEL charts typed"); platform events (`done.invoke.*`, `error.*`) are typed by the platform that
raises them, which is an assumption here. -/
def InputTyped (i : Input) : Prop := ∀ e, i.kind = .event e → EventTyped Γ e

/-- A start input whose invoker data fit their data items. -/
def StartTyped (si : StartInput) : Prop := ∀ p ∈ si.data, LocTyped Γ p.1 p.2

/-- A datamodel seen through its typing invariant: `Typed σ` (every typed location holds a value
of its type, in whatever sense the datamodel keeps it), its state after a request, and its
obligation that typed requests keep the invariant (a typed write stores a typed value, a typed
event becomes current, nothing else changes a typed location). The CEL datamodel discharges it
with its checked conversion on every store (`CelDatamodel::store`), the `rust` datamodel with
`Context::set`. -/
-- @tg: implements:: [[openspec:formal-model#Type Soundness Statement]]
structure Datamodel where
  St : Type
  Typed : St → Prop
  next : St → Request → St
  keeps : ∀ σ r, Typed σ → ReqTyped Γ r → Typed (next σ r)

end Vertep.Typed
