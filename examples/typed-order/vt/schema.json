                        "last4": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "last4"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "tag",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "tag": {
                      "const": "Invoice"
                    }
                  },
                  "required": [
                    "tag"
                  ],
                  "type": "object"
                }
              ]
            }
          },
          "required": [
            "amount",
